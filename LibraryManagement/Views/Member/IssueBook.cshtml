@model IssueBookViewModel;
@{
    Layout = "_Layout";
}
<div class="container">
<h1>Issue Book</h1>

@{
    if (ViewBag.AvailabilityMsg!=null)
    {
        <p>@ViewBag.AvailabilityMsg</p>
    }
    if (ViewBag.BorrowLimitMsg!=null)
    {
        <p>@ViewBag.BorrowLimitMsg</p>
    }
    if (ViewBag.UnreturnBooksMsg != null)
    {
        <p>@ViewBag.UnreturnBooksMsg</p>
    }
    if (ViewBag.UnPaidFineMsg != null)
    {
        <p>@ViewBag.UnPaidFineMsg</p>
    }
   
}

<form method="post" action="~/Member/IssueBook">
    <input type="text" hidden  name ="Id" value="@Model.Id"/>
<div class="m-3">
    <label>Book Title:</label>
        <input class="form-control" type="text" name="Title" readonly value="@Model.Title" />
        
</div>
<div class="m-3">
    <label>Book Author:</label>
        <input class="form-control"  type="text" name="Author" readonly value="@Model.Author" />
</div>

<div class="m-3">
    <label>Return Date:</label>
            <input class="form-control" type="date" name="ExpectedReturnDate"  min="@DateTime.Now.ToString("yyyy-MM-dd")"
                   max="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" />
            <span asp-validation-for="ExpectedReturnDate"></span>
</div>
<div class="d-flex m-3 gap-3">
  
        <button type="button" id="back" class="btn btn-primary">Back</button>
       
   
    @if (ViewBag.CanIssue == true)
    {
            <button type="submit" class="btn btn-primary">Issue Book</button>
    }
        </div>
</form>
    <div asp-validation-summary="ModelOnly"></div>
</div>

<script>
    document.getElementById('back').addEventListener('click', function () {
        window.location.href = '/Member/Index';
    });