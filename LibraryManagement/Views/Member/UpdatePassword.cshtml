@model UpdatePasswordViewModel
@{
    Layout = "_Layout";
}
<div class="row">
    <div class="col-4 m-auto">
        <h1>Update Password:</h1>
        <form asp-action="UpdatePassword" method="post" asp-controller="Member">
        <div class="m-3">
             <label asp-for="Password"></label>
             <input class="form-control" asp-for="Password"  type="password"/>
            <span asp-validation-for="Password"></span>
        </div>
        <div class="m-3">
             <label asp-for="ConfirmPassword"></label>
              <input class="form-control"  asp-for="ConfirmPassword" type="password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button class="btn btn-primary m-3" type="submit">Submit</button>
    </form>
    </div>
    <div asp-validation-summary="ModelOnly"></div>
</div>