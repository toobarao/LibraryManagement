@model List<AccountViewModel>;
@{
    Layout = "_Layout";
}
<div class="row d-flex">

    <div class="col-3">
        <h1>Filters</h1>
    </div>
    <div class="col-6">
        <h1>Your Accounts:</h1>
       @if(Model.Count==0)
            {
                <div>You dont have Unsettled Accounts</div>
            }
            else
            {
                
             <table class="table  table-sm table-striped ">
            <thead>
                <tr>
                   
                        <th>BookName</th>
                        <th>BookAuthor </th>
                        <th>BorrowDate</th>
                        <th>ReturnedDate</th>
                        <th>Fine</th>
                        <th>Action</th>

                </tr>

            </thead>
            <tbody>
                @foreach(var account in Model)
                {
                        <tr>
                            <td>@account.BookName</td>
                            <td>@account.BookAuthor</td>
                            <td>@account.BorrowDate?.ToString("yyyy-mm-dd")</td>
                            @if(account.ReturnedDate==null)
                            {
                                <td>Not Returned</td>
                                <td>20000</td>
                            }
                            else{
                            <td>@account.ReturnedDate?.ToString("yyyy-mm-dd")</td>
                                <td>@account.Fine.ToString("F2")</td>
        }

                            <td><button class="btn btn-primary">Pay</button></td>
                        </tr>
                    }
                </tbody>
                </table>
            }
        </div>

</div>

    