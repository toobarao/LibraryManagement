@model List<Reservation>;
@{
    Layout = "_Layout";
}
    <div class="row">
    <div class="col-3">
        <form asp-action="Reserve">
            <h2 class="mx-3">Filters</h2>
            <div class="m-3">
                <label for="author">Author:</label>
                <input class="form-control" type="text" name="searchAuthor" value="@ViewData["Author"]" />
            </div>
            <div class="m-3">
                <label for="author">Availability:</label>
                <div class="d-flex gap-3">
                    <label for="author">
                        <input class="form-check-input" type="radio" name="availability" value="true" />
                        Yes
                    </label>
                    <label for="author">
                        <input class="form-check-input" type="radio" name="availability" value="false" />
                        No
                    </label>
                </div>
            </div>
            <div class="m-3 d-flex gap-3">
                <button class="btn  btn-primary" type="submit">Filter</button>
                <button class="btn  btn-primary" type="submit">Reset</button>
            </div>
        </form>
    </div>
    <div class="col-9">
        <h1>List Of Books</h1>
        @if(Model.Count()==0)
        {<p>You have'nt reserve any books</p>}
        else{
        <table class="table  table-sm table-striped ">
            <thead>
                <tr>
                <th>Book Title</th>
                <th>Book Author</th>
                <th>Availability</th>
                </tr>
            </thead>
            <tbody>
                
                   @foreach(var reserve in Model)
                {
                    <tr>
                        <td>@reserve.book.Title</td>
                        <td>@reserve.book.Author</td>
                        <td>@reserve.book.Availability</td>
                    </tr>
                }

            </tbody>
            </table>
       } </div>
    </div>
    </div>