@model List<Borrowing>;
@{
    Layout = "_Layout";
}
    
<h1>Borrowed Books</h1>
@if(!Model.Any())
{
    <p>You havent borrow any of the books</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
               
                <th>Book Title</th>
                <th>Book Author </th>
                <th>Borrow Date</th>
                <th>Promised Return Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var book in Model)
            {
                <tr>
                    <td>@book.Book.Title</td>
                    <td>@book.Book.Author</td>
                    <td>@(book.BorrowDate==null?"-":@book.BorrowDate)</td>
                    <td>@book.ExpectedReturnDate</td>
                    <td>
                        <form asp-action="ReturnBook" asp-controller="Member">
                            <input name="Id" value="@book.Id" hidden/>
                        <button class="btn btn-primary">Return</button>
                        </form>
                    </td>
                    
                   
                </tr>
            }
        </tbody>
    </table>
}